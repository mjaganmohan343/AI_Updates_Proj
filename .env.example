# ==========================================
# Autonomous Daily AI & Semiconductor Analyst
# Configuration (.env)
# ==========================================

# 1. Google Gemini API Key (100% Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Public Website URL (Where your GitHub Pages or blog is hosted)
WEBSITE_URL=https://your-username.github.io/AI_Updates_Proj/

# 3. Optional: Email Dispatch via Gmail (Free)
# Generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_RECIPIENTS=your_email@gmail.com,colleague@company.com

# 4. Optional: Telegram Dispatch (Free)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
